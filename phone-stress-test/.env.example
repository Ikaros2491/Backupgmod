# Twilio credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Twilio number you own / rented (E.164), used as the caller ID
TWILIO_FROM_NUMBER=+15551234567

# The single phone line YOU own that will receive the test calls (E.164)
TARGET_NUMBER=+15557654321

# Optional: custom TwiML URL. Default is Twilio's demo voice XML.
# TWIML_URL=http://demo.twilio.com/docs/voice.xml
